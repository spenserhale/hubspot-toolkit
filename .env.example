# HubSpot private app access token — create at
# https://app.hubspot.com/private-apps  (Settings -> Integrations -> Private Apps)
# Grant crm.objects.* (read/write) scopes for whichever objects you need.
#
# Recommended: keep the token out of plaintext files and store it in the OS keychain:
#   hubspot auth set hubspot           (hidden prompt; or pipe it with --stdin)
#   hubspot auth migrate               (copies a HUBSPOT_ACCESS_TOKEN from .env into the keychain)
# A value set here still overrides the keychain, so delete the line after migrating.
HUBSPOT_ACCESS_TOKEN=

# Optional explicit base URL override
# HUBSPOT_BASE_URL=https://api.hubapi.com

# Optional: set to 0 to never read the OS keychain (CI, headless Linux without a Secret Service)
# HUBSPOT_KEYCHAIN=0
